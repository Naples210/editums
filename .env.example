# Copy to .env.local for local development. Never commit real keys.

# Sending-only Resend API key restricted to mail.editums.com
RESEND_API_KEY=

# Signing secret from the Resend webhook pointing at /api/webhooks/resend
RESEND_WEBHOOK_SECRET=

EMAIL_FROM="Editums <noreply@mail.editums.com>"
EMAIL_REPLY_TO=hello@mail.editums.com
NEXT_PUBLIC_APP_URL=https://editums.com
